---
// Iconos de línea 1,5px, esquinas redondeadas, sin relleno (reglas de iconografía AROMATO).
import type { IconName } from '../data/links';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className = 'size-5' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'catalog' && (
    <>
      <path d="M4 5.5C6.5 4.5 9.5 4.5 12 6c2.5-1.5 5.5-1.5 8-.5v13c-2.5-1-5.5-1-8 .5-2.5-1.5-5.5-1.5-8-.5z" />
      <path d="M12 6v13" />
    </>
  )}
  {name === 'instagram' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r=".6" />
    </>
  )}
  {name === 'tiktok' && (
    <>
      <path d="M13.5 3.5v11.25a3.25 3.25 0 1 1-3.25-3.25" />
      <path d="M13.5 3.5c.4 2.6 2.3 4.4 5 4.6" />
    </>
  )}
  {name === 'facebook' && (
    <path d="M14.5 20.5v-7.5h2.5l.5-3h-3V8.25c0-.9.4-1.5 1.6-1.5h1.5V4.1c-.5-.1-1.4-.2-2.3-.2-2.4 0-3.8 1.4-3.8 4v2.1H9v3h2.5v7.5" />
  )}
  {name === 'whatsapp' && (
    <>
      <path d="M4 20l1.2-4.1A8.5 8.5 0 1 1 8.3 19z" />
      <path d="M9.2 8.6c.2-.4.5-.5.8-.5h.4c.2 0 .3.1.4.3l.6 1.4c.1.2 0 .4-.1.5l-.4.5c.5 1.1 1.4 2 2.5 2.5l.5-.4c.1-.1.3-.2.5-.1l1.4.6c.2.1.3.2.3.4v.4c0 .3-.1.6-.5.8-.5.3-1.2.4-1.9.2-2.1-.6-3.8-2.3-4.4-4.4-.2-.7-.1-1.4.2-1.9z" />
    </>
  )}
</svg>
