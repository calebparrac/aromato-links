---
import Base from '../layouts/Base.astro';
import Isotipo from '../components/Isotipo.astro';
import LinkButton from '../components/LinkButton.astro';
import { links } from '../data/links';
---

<Base
  title="AROMATO · Perfumería"
  description="Perfumería de lujo original y decants de 3, 5, 10 y 30 ml en Barranquilla. Tu firma invisible."
>
  <main class="mx-auto flex max-w-[420px] flex-col items-center text-center">
    <header class="flex flex-col items-center gap-6">
      <Isotipo class="size-[72px]" />
      <div class="flex flex-col items-center gap-3">
        <!-- El margen negativo compensa el tracking final para centrar ópticamente -->
        <h1 class="mr-[-0.42em] text-[30px] leading-[30px] font-light tracking-[0.42em] uppercase">Aromato</h1>
        <span class="mr-[-0.52em] text-[12px] leading-[12px] font-light tracking-[0.52em] text-accent-gold uppercase">
          Perfumería
        </span>
      </div>
    </header>

    <hr class="my-8 w-12 border-0 border-t border-border-gold" />

    <p class="font-serif text-[22px] leading-[30px] italic">Tu firma invisible.</p>
    <p class="caption mt-3 text-ink-secondary tabular-nums">Originales y decants de 3, 5, 10 y 30 ml</p>

    <ul class="mt-12 flex w-full flex-col gap-4">
      {links.map((link) => <LinkButton {...link} />)}
    </ul>

    <footer class="overline mt-16 w-full border-t border-border-hairline pt-6 text-ink-secondary">
      Barranquilla · Soledad
    </footer>
  </main>
</Base>
